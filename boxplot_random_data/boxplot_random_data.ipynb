      "source": [
        "import seaborn as sns\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "data = np.random.randn(1000)\n",
        "\n",
        "sns.boxplot(data=data)\n",
        "plt.title('Boxplot of Random Data', fontweight='bold')\n",
        "plt.show()"
      ],
