      "source": [
        "import networkx as nx\n",
        "import matplotlib.pyplot as plt"
      ],
      "metadata": {
        "id": "Jy3cwhqm2C92"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "graph = nx.cycle_graph(5)\n",
        "pos = nx.spring_layout(graph)\n",
        "\n",
        "nx.draw(graph, pos, with_labels=True, node_size=10, node_color='skyblue')\n",
        "plt.title('Network Graph', fontweight='bold')\n",
        "plt.show()"
      ],
